#!/bin/bash
# squish — watch a folder and auto-compress videos with ffmpeg.
#
# Thin entry point: resolve our real location (following the ~/bin symlink),
# source the lib modules, then dispatch. All logic lives in lib/.
#
#   squish help
set -uo pipefail

# Resolve this script's real directory, even when invoked via a symlink.
source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  [[ "$source_path" != /* ]] && source_path="$dir/$source_path"
done
SQUISH_ROOT="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"

for mod in common config agent worker clean cli; do
  # shellcheck source=/dev/null
  source "$SQUISH_ROOT/lib/$mod.sh"
done

cli_main "$@"
